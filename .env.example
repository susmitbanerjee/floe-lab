# Lab settings. `make up` copies this file to .env when .env is missing.
# Every value here is lab-only and obviously fake. Never reuse any of them anywhere else.

# Object store (RustFS) root credentials, also used by the warehouse and the smoke test.
FLOE_LAB_S3_ACCESS_KEY=floe-lab-access
FLOE_LAB_S3_SECRET_KEY=floe-lab-secret
FLOE_LAB_S3_REGION=local-01

# Postgres for Lakekeeper only. Keep the password in step with the database URL below.
FLOE_LAB_PG_PASSWORD=floe-lab-postgres
LAKEKEEPER__PG_DATABASE_URL_WRITE=postgresql://lakekeeper:floe-lab-postgres@postgres:5432/lakekeeper

# Key Lakekeeper uses to encrypt the storage credentials it keeps in Postgres.
LAKEKEEPER__PG_ENCRYPTION_KEY=floe-lab-not-a-secret-encryption-key

# Optional overrides (defaults shown) for running clients somewhere other than this host.
# FLOE_LAB_S3_ENDPOINT=http://127.0.0.1:9000
# FLOE_LAB_CATALOG_URL=http://127.0.0.1:8181

# AWS Glue catalog for `make data CATALOG=glue` (the AWS lab). Credentials come from your own
# AWS profile or SSO session, never from this file.
# FLOE_LAB_GLUE_REGION=ap-south-1
# FLOE_LAB_GLUE_WAREHOUSE=s3://your-lab-bucket/warehouse
